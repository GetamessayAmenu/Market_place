# Root environment template — copy to .env for local reference.
# Service-specific secrets belong in services/*/ and apps/*/.env files.

NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
REALTIME_URL=http://localhost:3002

# Database (also copy to prisma/.env for CLI)
DATABASE_URL=postgresql://marketplace:marketplace@localhost:5433/marketplace?schema=public
