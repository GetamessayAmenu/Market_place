  title             String        @db.VarChar(200)
  titleAm           String?       @map("title_am") @db.VarChar(200)
  subtitle          String?       @db.VarChar(300)
  subtitleAm        String?       @map("subtitle_am") @db.VarChar(300)
  imageUrl          String        @map("image_url") @db.VarChar(500)
  cloudinaryPublicId String?       @map("cloudinary_public_id") @db.VarChar(255)
  linkUrl           String?       @map("link_url") @db.VarChar(500)
  holidayTheme      HolidayTheme? @map("holiday_theme")
  themeStartDate    DateTime?     @map("theme_start_date")
  themeEndDate      DateTime?     @map("theme_end_date")
  searchWeight      Float         @default(1.0) @map("search_weight")
  status            ContentStatus @default(draft)
  sortOrder         Int           @default(0) @map("sort_order")
  publishAt         DateTime?     @map("publish_at")
  unpublishAt       DateTime?     @map("unpublish_at")
  createdById       String        @map("created_by_id") @db.Uuid
