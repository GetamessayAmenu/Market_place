// Marketplace Platform — PostgreSQL schema
// Shared across services/api (modular monolith)
// UUID strategy: native PostgreSQL uuid via @db.Uuid

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums (aligned with @marketplace/types where applicable)
// ---------------------------------------------------------------------------

enum UserStatus {
  active
  suspended
  banned
  pending_verification
}

enum ListingStatus {
  draft
  pending_review
  active
  sold
  expired
  rejected
  archived
}

enum CategoryType {
  product
  rental
  custom_service
}

enum AttributeType {
  size
  color
  material
  brand
  custom
}

enum ListingCondition {
  new
  like_new
  good
  fair
  poor
}

enum ReportTargetType {
  listing
  user
  message
  conversation
}

enum ReportStatus {
  pending
  under_review
  investigating
  resolved
  dismissed
  closed
}

enum DisputeStatus {
  open
  in_progress
  awaiting_response
  under_review
  resolved
  closed
  escalated
}

enum DisputePriority {
  low
  medium
  high
  urgent
}

enum DisputeType {
  off_platform_transaction
  payment_dispute
  delivery_issue
  quality_mismatch
  communication_conflict
  other
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RentalStatus {
  REQUESTED
  APPROVED
  HANDOVER_PENDING
  ACTIVE
  RETURN_INITIATED
  RETURNED_INSPECTED
  COMPLETED
  DISPUTED
}

enum HolidayTheme {
  MESKEL
  TIMKET
  ENKUTATASH
  TLEK_SERG
  FASIKA
}

enum SellerType {
  designer
  tailor
  boutique
  rental_shop
}

enum NotificationType {
  listing_approved
  listing_rejected
  new_message
  new_offer
  report_update
  verification_update
  system
}

enum VerificationType {
  email
  phone
  identity
  business
}

enum VerificationStatus {
  pending
  approved
  rejected
  cancelled
}

enum CustomOrderStatus {
  submitted
  under_review
  confirmed
  in_production
  shipped
  delivered
  cancelled
}

enum OrderType {
  product
  rental
  custom_service
}

enum OrderStatus {
  pending
  confirmed
  processing
  shipped
  delivered
  cancelled
  refunded
}

enum PaymentStatus {
  pending
  processing
  paid
  failed
  refunded
  partial_refund
}

enum ReviewTargetType {
  listing
  seller
}

enum ModerationStatus {
  pending
  approved
  rejected
  under_review
  deleted
  restored
}

enum ModerationItemType {
  review
  product_image
  store_logo
  store_banner
  store_gallery
  custom_service_description
  custom_service_reference
}

enum ContentStatus {
  draft
  published
  scheduled
  archived
}

enum ContentType {
  hero_banner
  featured_product
  featured_rental
  featured_custom_service
  promotional_section
  homepage_category
}

// ---------------------------------------------------------------------------
// RBAC
// ---------------------------------------------------------------------------

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(50)
  slug        String   @unique @db.VarChar(50)
  description String?  @db.VarChar(255)
  isSystem    Boolean  @default(true) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  resource    String   @db.VarChar(50)
  action      String   @db.VarChar(50)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@index([resource])
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ---------------------------------------------------------------------------
// Users
// ---------------------------------------------------------------------------

model User {
  id              String      @id @default(uuid()) @db.Uuid
  email           String      @unique @db.VarChar(255)
  passwordHash    String      @map("password_hash") @db.VarChar(255)
  displayName     String      @map("display_name") @db.VarChar(100)
  avatarUrl       String?     @map("avatar_url") @db.VarChar(500)
  phone           String?     @unique @db.VarChar(20)
  bio             String?     @db.Text
  location        String?     @db.VarChar(200)
  sellerType      SellerType? @map("seller_type")
  isVerifiedDesigner Boolean  @default(false) @map("is_verified_designer")
  verifiedDesignerAt DateTime? @map("verified_designer_at")
  verifiedDesignerById String? @map("verified_designer_by_id") @db.Uuid
  coverImageUrl   String?     @map("cover_image_url") @db.VarChar(500)
  specialties     String[]    @default([])
  socialLinks     Json?       @map("social_links")
  responseRate    Int?        @map("response_rate")
  responseTimeHours Int?      @map("response_time_hours")
  totalSales      Int?        @map("total_sales")
  emailVerifiedAt DateTime?   @map("email_verified_at")
  phoneVerifiedAt DateTime?   @map("phone_verified_at")
  status          UserStatus  @default(active)
  roleId          String      @map("role_id") @db.Uuid
  lastLoginAt     DateTime?   @map("last_login_at")
  deletedAt       DateTime?   @map("deleted_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  role Role @relation(fields: [roleId], references: [id])
  verifiedDesignerBy User? @relation("VerifiedDesigner", fields: [verifiedDesignerById], references: [id])
  verifiedDesigners User[] @relation("VerifiedDesigner")

  listings             Listing[]
  favorites            Favorite[]
  buyerConversations   Conversation[]        @relation("BuyerConversations")
  sellerConversations  Conversation[]        @relation("SellerConversations")
  sentMessages         Message[]
  reportsFiled         Report[]              @relation("ReportsFiled")
  reportsAgainst       Report[]              @relation("ReportedUser")
  reportsResolved      Report[]              @relation("ReportsResolved")
  notifications        Notification[]
  adminLogs            AdminLog[]
  verificationRequests VerificationRequest[]
  verificationReviews  VerificationRequest[] @relation("VerificationReviewer")
  customOrdersAsBuyer  CustomOrder[]         @relation("CustomOrderBuyer")
  customOrdersAsSeller CustomOrder[]         @relation("CustomOrderSeller")
  ordersAsBuyer       Order[]                @relation("OrderBuyer")
  ordersAsSeller      Order[]                @relation("OrderSeller")
  reviewsWritten       Review[]              @relation("ReviewsWritten")
  reviewsReceived      Review[]              @relation("ReviewsReceived")
  reviewsModerated     Review[]              @relation("ReviewsModerated")
  followers            Follow[]              @relation("Following")
  following            Follow[]              @relation("Followed")
  callbackRequests     CallbackRequest[]
  moderationItemsModerated ModerationItem[] @relation("ModerationItemsModerated")
  moderationReportsFiled   ModerationReport[] @relation("ModerationReportsFiled")
  moderationReportsResolved ModerationReport[] @relation("ModerationReportsResolved")
  homepageContentCreated  HomepageContent[] @relation("HomepageContentCreated")
  homepageContentUpdated  HomepageContent[] @relation("HomepageContentUpdated")
  disputesReported     Dispute[]             @relation("DisputeReporter")
  disputesAgainst      Dispute[]             @relation("DisputeReportedUser")
  disputesResolved     Dispute[]             @relation("DisputeResolver")
  disputesEscalated    Dispute[]             @relation("DisputeEscalator")
  disputeComments      DisputeComment[]
  vendorKycProfile     VendorKycProfile?
  kycProfilesReviewed  VendorKycProfile[]    @relation("KycReviewer")
  rentalOrdersAsRenter RentalOrder[]         @relation("RentalRenter")
  rentalOrdersAsSeller RentalOrder[]         @relation("RentalSeller")
  rentalExtensionsRequested RentalExtension[] @relation("ExtensionRequester")
  rentalExtensionsApproved  RentalExtension[] @relation("ExtensionApprover")
  heroBannersCreated   HeroBanner[]          @relation("HeroBannerCreated")
  heroBannersUpdated   HeroBanner[]          @relation("HeroBannerUpdated")

  @@index([roleId])
  @@index([status])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([sellerType])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Category {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @db.VarChar(100)
  nameAm      String?      @map("name_am") @db.VarChar(100)
  slug        String       @unique @db.VarChar(120)
  slugAm      String?      @map("slug_am") @db.VarChar(120)
  parentId    String?      @map("parent_id") @db.Uuid
  type        CategoryType @default(product)
  description String?      @db.Text
  descriptionAm String?    @map("description_am") @db.Text
  iconUrl     String?      @map("icon_url") @db.VarChar(500)
  sortOrder   Int          @default(0) @map("sort_order")
  isActive    Boolean      @default(true) @map("is_active")
  deletedAt   DateTime?    @map("deleted_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  parent        Category?              @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children      Category[]             @relation("CategoryHierarchy")
  listings      Listing[]
  categoryAttributes CategoryAttribute[]
  homepageFeaturedContent HomepageContent[] @relation("HomepageFeaturedCategory")

  @@index([parentId])
  @@index([isActive, deletedAt])
  @@index([sortOrder])
  @@index([type])
  @@map("categories")
}

model Attribute {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @db.VarChar(100)
  type        AttributeType
  values      Json         @db.JsonB
  sortOrder   Int          @default(0) @map("sort_order")
  isActive    Boolean      @default(true) @map("is_active")
  deletedAt   DateTime?    @map("deleted_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  categoryAttributes CategoryAttribute[]

  @@index([type])
  @@index([isActive, deletedAt])
  @@index([sortOrder])
  @@map("attributes")
}

model CategoryAttribute {
  id         String   @id @default(uuid()) @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  attributeId String  @map("attribute_id") @db.Uuid
  required   Boolean  @default(false)
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attribute Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([categoryId, attributeId])
  @@index([categoryId])
  @@index([attributeId])
  @@map("category_attributes")
}

model Listing {
  id             String           @id @default(uuid()) @db.Uuid
  sellerId       String           @map("seller_id") @db.Uuid
  categoryId     String           @map("category_id") @db.Uuid
  title          String           @db.VarChar(200)
  slug           String           @unique @db.VarChar(220)
  description    String           @db.Text
  price          Decimal          @db.Decimal(12, 2)
  currency       String           @default("USD") @db.VarChar(3)
  condition      ListingCondition
  status         ListingStatus    @default(draft)
  city           String?          @db.VarChar(100)
  state          String?          @db.VarChar(100)
  country        String?          @db.VarChar(2)
  latitude       Decimal?         @db.Decimal(10, 7)
  longitude      Decimal?         @db.Decimal(10, 7)
  viewCount      Int              @default(0) @map("view_count")
  isFeatured             Boolean          @default(false) @map("is_featured")
  contactOptions         Json?            @map("contact_options") @db.JsonB
  availableForPurchase   Boolean          @default(true) @map("available_for_purchase")
  availableForRent       Boolean          @default(false) @map("available_for_rent")
  customOrderAvailable   Boolean          @default(false) @map("custom_order_available")
  rentalPricePerDay      Decimal?         @map("rental_price_per_day") @db.Decimal(12, 2)
  rentalDeposit          Decimal?         @map("rental_deposit") @db.Decimal(12, 2)
  attributes             Json?            @db.JsonB
  publishedAt            DateTime?        @map("published_at")
  expiresAt              DateTime?        @map("expires_at")
  rejectedReason         String?          @map("rejected_reason") @db.VarChar(500)
  deletedAt              DateTime?        @map("deleted_at")
  createdAt              DateTime         @default(now()) @map("created_at")
  updatedAt              DateTime         @updatedAt @map("updated_at")

  seller        User           @relation(fields: [sellerId], references: [id])
  category      Category       @relation(fields: [categoryId], references: [id])
  images        ListingImage[]
  favorites     Favorite[]
  conversations Conversation[]
  reports       Report[]
  customOrders  CustomOrder[]
  orders        Order[]
  reviews       Review[]
  callbackRequests     CallbackRequest[]
  priceHistory         ListingPriceHistory[]
  homepageFeaturedContent HomepageContent[] @relation("HomepageFeaturedListing")
  disputes      Dispute[]
  rentalOrders  RentalOrder[]

  @@index([sellerId, status])
  @@index([categoryId, status])
  @@index([status, createdAt(sort: Desc)])
  @@index([status, publishedAt(sort: Desc)])
  @@index([city, country])
  @@index([price])
  @@index([deletedAt])
  @@index([createdAt(sort: Desc)])
  @@index([availableForPurchase, status])
  @@index([availableForRent, status])
  @@index([customOrderAvailable, status])
  @@map("listings")
}

model ListingImage {
  id                 String    @id @default(uuid()) @db.Uuid
  listingId          String    @map("listing_id") @db.Uuid
  url                String    @db.VarChar(500)
  cloudinaryPublicId String    @map("cloudinary_public_id") @db.VarChar(255)
  sortOrder          Int       @default(0) @map("sort_order")
  isPrimary          Boolean   @default(false) @map("is_primary")
  deletedAt          DateTime? @map("deleted_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, sortOrder])
  @@index([listingId, isPrimary])
  @@index([deletedAt])
  @@map("listing_images")
}

model Favorite {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  listingId String   @map("listing_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([listingId])
  @@map("favorites")
}

model Follow {
  id          String   @id @default(uuid()) @db.Uuid
  followerId  String   @map("follower_id") @db.Uuid
  followingId String   @map("following_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  follower  User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Followed", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("follows")
}

// ---------------------------------------------------------------------------
// Messaging
// ---------------------------------------------------------------------------

model Conversation {
  id            String    @id @default(uuid()) @db.Uuid
  listingId     String    @map("listing_id") @db.Uuid
  buyerId       String    @map("buyer_id") @db.Uuid
  sellerId      String    @map("seller_id") @db.Uuid
  lastMessageAt DateTime? @map("last_message_at")
  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  listing      Listing       @relation(fields: [listingId], references: [id])
  buyer        User          @relation("BuyerConversations", fields: [buyerId], references: [id])
  seller       User          @relation("SellerConversations", fields: [sellerId], references: [id])
  messages     Message[]
  reports      Report[]
  customOrders CustomOrder[]
  disputes     Dispute[]

  @@unique([listingId, buyerId, sellerId])
  @@index([buyerId, lastMessageAt(sort: Desc)])
  @@index([sellerId, lastMessageAt(sort: Desc)])
  @@index([deletedAt])
  @@map("conversations")
}

model Message {
  id             String    @id @default(uuid()) @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  senderId       String    @map("sender_id") @db.Uuid
  body           String    @db.Text
  readAt         DateTime? @map("read_at")
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id])
  reports      Report[]

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([senderId])
  @@index([readAt])
  @@index([deletedAt])
  @@map("messages")
}

// ---------------------------------------------------------------------------
// Trust & Safety
// ---------------------------------------------------------------------------

model Report {
  id             String           @id @default(uuid()) @db.Uuid
  reporterId     String           @map("reporter_id") @db.Uuid
  targetType     ReportTargetType @map("target_type")
  listingId      String?          @map("listing_id") @db.Uuid
  reportedUserId String?          @map("reported_user_id") @db.Uuid
  messageId      String?          @map("message_id") @db.Uuid
  conversationId String?          @map("conversation_id") @db.Uuid
  reason         String           @db.VarChar(100)
  description    String?          @db.Text
  evidence       String[]         @default([])
  status         ReportStatus     @default(pending)
  resolutionNote String?          @map("resolution_note") @db.Text
  resolvedById   String?          @map("resolved_by_id") @db.Uuid
  resolvedAt     DateTime?        @map("resolved_at")
  closedAt       DateTime?        @map("closed_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  reporter     User          @relation("ReportsFiled", fields: [reporterId], references: [id])
  listing      Listing?      @relation(fields: [listingId], references: [id], onDelete: SetNull)
  reportedUser User?         @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: SetNull)
  message      Message?      @relation(fields: [messageId], references: [id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  resolvedBy   User?         @relation("ReportsResolved", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt(sort: Desc)])
  @@index([targetType, status])
  @@index([reporterId])
  @@index([listingId])
  @@index([reportedUserId])
  @@map("reports")
}

// ---------------------------------------------------------------------------
// Notifications & Admin
// ---------------------------------------------------------------------------

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String           @db.VarChar(200)
  body      String?          @db.Text
  data      Json?            @db.JsonB
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt(sort: Desc)])
  @@index([type])
  @@map("notifications")
}

model AdminLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  action     String   @db.VarChar(100)
  resource   String   @db.VarChar(50)
  resourceId String?  @map("resource_id") @db.Uuid
  metadata   Json?    @db.JsonB
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.VarChar(500)
  createdAt  DateTime @default(now()) @map("created_at")

  actor User @relation(fields: [actorId], references: [id])

  @@index([actorId, createdAt(sort: Desc)])
  @@index([resource, resourceId])
  @@index([action])
  @@index([createdAt(sort: Desc)])
  @@map("admin_logs")
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

model Order {
  id                String         @id @default(uuid()) @db.Uuid
  orderNumber       String         @unique @map("order_number") @db.VarChar(20)
  type              OrderType
  status            OrderStatus    @default(pending)
  paymentStatus     PaymentStatus  @default(pending) @map("payment_status")
  buyerId           String         @map("buyer_id") @db.Uuid
  sellerId          String         @map("seller_id") @db.Uuid
  listingId         String         @map("listing_id") @db.Uuid
  totalAmount       Decimal        @map("total_amount") @db.Decimal(12, 2)
  currency          String         @default("USD") @db.VarChar(3)
  
  // Rental-specific fields
  rentalStartDate   DateTime?      @map("rental_start_date")
  rentalEndDate     DateTime?      @map("rental_end_date")
  rentalDeposit     Decimal?       @map("rental_deposit") @db.Decimal(12, 2)
  
  // Custom service-specific fields
  customOrderId     String?        @map("custom_order_id") @db.Uuid
  measurements      Json?          @db.JsonB
  fabricChoice      String?        @map("fabric_choice") @db.VarChar(100)
  colorChoice       String?        @map("color_choice") @db.VarChar(100)
  designNotes       String?        @map("design_notes") @db.Text
  
  // Shipping
  shippingAddress   Json?          @map("shipping_address") @db.JsonB
  trackingNumber    String?        @map("tracking_number") @db.VarChar(100)
  
  // Payment
  paymentMethod     String?        @map("payment_method") @db.VarChar(50)
  paymentId         String?        @map("payment_id") @db.VarChar(100)
  
  // Cancellation/Refund
  cancelledAt       DateTime?      @map("cancelled_at")
  cancelledReason   String?        @map("cancelled_reason") @db.VarChar(500)
  refundedAt        DateTime?      @map("refunded_at")
  refundAmount      Decimal?       @map("refund_amount") @db.Decimal(12, 2)
  refundReason      String?        @map("refund_reason") @db.VarChar(500)
  
  // Timestamps
  confirmedAt       DateTime?      @map("confirmed_at")
  shippedAt         DateTime?      @map("shipped_at")
  deliveredAt       DateTime?      @map("delivered_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  buyer       User        @relation("OrderBuyer", fields: [buyerId], references: [id])
  seller      User        @relation("OrderSeller", fields: [sellerId], references: [id])
  listing     Listing     @relation(fields: [listingId], references: [id])
  customOrder CustomOrder? @relation("CustomOrder", fields: [customOrderId], references: [id])

  @@index([buyerId, status])
  @@index([sellerId, status])
  @@index([type, status])
  @@index([status, createdAt(sort: Desc)])
  @@index([orderNumber])
  @@map("orders")
}

// ---------------------------------------------------------------------------
// Custom Orders
// ---------------------------------------------------------------------------

model CustomOrder {
  id               String            @id @default(uuid()) @db.Uuid
  listingId        String            @map("listing_id") @db.Uuid
  buyerId          String            @map("buyer_id") @db.Uuid
  sellerId         String            @map("seller_id") @db.Uuid
  status           CustomOrderStatus @default(submitted)
  measurements     Json?             @db.JsonB
  fabricChoice     String?           @map("fabric_choice") @db.VarChar(100)
  colorChoice      String?           @map("color_choice") @db.VarChar(100)
  designNotes      String?           @map("design_notes") @db.Text
  referenceImages  String[]          @map("reference_images")
  estimatedPrice   Decimal?          @map("estimated_price") @db.Decimal(12, 2)
  finalPrice       Decimal?          @map("final_price") @db.Decimal(12, 2)
  estimatedDays    Int?              @map("estimated_days")
  conversationId   String?           @map("conversation_id") @db.Uuid
  cancelledReason  String?           @map("cancelled_reason") @db.VarChar(500)
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  listing      Listing       @relation(fields: [listingId], references: [id])
  buyer        User          @relation("CustomOrderBuyer", fields: [buyerId], references: [id])
  seller       User          @relation("CustomOrderSeller", fields: [sellerId], references: [id])
  conversation Conversation? @relation(fields: [conversationId], references: [id])
  orders       Order[]       @relation("CustomOrder")

  @@index([buyerId, status])
  @@index([sellerId, status])
  @@index([listingId])
  @@index([status, createdAt(sort: Desc)])
  @@map("custom_orders")
}

// ---------------------------------------------------------------------------
// Reviews
// ---------------------------------------------------------------------------

model Review {
  id                  String           @id @default(uuid()) @db.Uuid
  listingId           String           @map("listing_id") @db.Uuid
  reviewerId          String           @map("reviewer_id") @db.Uuid
  sellerId            String           @map("seller_id") @db.Uuid
  rating              Int              @db.SmallInt
  title               String?          @db.VarChar(200)
  body                String?          @db.Text
  images              String[]
  verifiedPurchase    Boolean          @default(false) @map("verified_purchase")
  helpfulCount        Int              @default(0) @map("helpful_count")
  moderationStatus    ModerationStatus @default(pending) @map("moderation_status")
  moderationReason    String?          @map("moderation_reason") @db.Text
  moderatedById       String?          @map("moderated_by_id") @db.Uuid
  moderatedAt         DateTime?        @map("moderated_at")
  isSpam              Boolean          @default(false) @map("is_spam")
  spamScore           Int?             @map("spam_score")
  deletedAt           DateTime?        @map("deleted_at")
  restoredAt          DateTime?        @map("restored_at")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  listing       Listing       @relation(fields: [listingId], references: [id])
  reviewer      User          @relation("ReviewsWritten", fields: [reviewerId], references: [id])
  seller        User          @relation("ReviewsReceived", fields: [sellerId], references: [id])
  moderatedBy   User?         @relation("ReviewsModerated", fields: [moderatedById], references: [id])
  moderationItems ModerationItem[]

  @@unique([reviewerId, listingId])
  @@index([listingId, createdAt(sort: Desc)])
  @@index([sellerId, createdAt(sort: Desc)])
  @@index([rating])
  @@index([moderationStatus, createdAt(sort: Desc)])
  @@index([isSpam])
  @@index([deletedAt])
  @@map("reviews")
}

model VerificationRequest {
  id              String             @id @default(uuid()) @db.Uuid
  userId          String             @map("user_id") @db.Uuid
  type            VerificationType
  status          VerificationStatus @default(pending)
  documentUrl     String?            @map("document_url") @db.VarChar(500)
  metadata        Json?              @db.JsonB
  reviewedById    String?            @map("reviewed_by_id") @db.Uuid
  reviewedAt      DateTime?          @map("reviewed_at")
  rejectionReason String?            @map("rejection_reason") @db.VarChar(500)
  deletedAt       DateTime?          @map("deleted_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("VerificationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([userId, type, status])
  @@index([status, createdAt(sort: Desc)])
  @@index([reviewedById])
  @@index([deletedAt])
  @@map("verification_requests")
}

// ---------------------------------------------------------------------------
// Callback Requests & Price History
// ---------------------------------------------------------------------------

model CallbackRequest {
  id            String   @id @default(uuid()) @db.Uuid
  listingId     String   @map("listing_id") @db.Uuid
  sellerId      String   @map("seller_id") @db.Uuid
  buyerName     String   @map("buyer_name") @db.VarChar(255)
  buyerPhone    String   @map("buyer_phone") @db.VarChar(20)
  preferredTime String?  @map("preferred_time") @db.VarChar(100)
  message       String?  @db.Text
  status        String   @default("pending") @db.VarChar(20)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  seller  User    @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([sellerId])
  @@map("callback_requests")
}

model ListingPriceHistory {
  id        String   @id @default(uuid()) @db.Uuid
  listingId String   @map("listing_id") @db.Uuid
  price     Decimal  @db.Decimal(12, 2)
  currency  String   @default("USD") @db.VarChar(3)
  createdAt DateTime @default(now()) @map("created_at")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@map("listing_price_history")
}

// ---------------------------------------------------------------------------
// Content Moderation
// ---------------------------------------------------------------------------

model ModerationItem {
  id                  String            @id @default(uuid()) @db.Uuid
  itemType            ModerationItemType @map("item_type")
  itemId              String            @map("item_id") @db.Uuid
  reviewId            String?           @map("review_id") @db.Uuid
  content             String?           @db.Text
  imageUrl            String?           @map("image_url") @db.VarChar(500)
  cloudinaryPublicId  String?           @map("cloudinary_public_id") @db.VarChar(255)
  status              ModerationStatus  @default(pending)
  rejectionReason     String?           @map("rejection_reason") @db.Text
  moderatedById       String?           @map("moderated_by_id") @db.Uuid
  moderatedAt         DateTime?         @map("moderated_at")
  isSpam              Boolean           @default(false) @map("is_spam")
  spamScore           Int?              @map("spam_score")
  reportCount         Int               @default(0) @map("report_count")
  deletedAt           DateTime?         @map("deleted_at")
  restoredAt          DateTime?         @map("restored_at")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  review       Review? @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  moderatedBy  User?   @relation("ModerationItemsModerated", fields: [moderatedById], references: [id])
  reports      ModerationReport[]

  @@index([itemType, status, createdAt(sort: Desc)])
  @@index([itemId])
  @@index([reviewId])
  @@index([isSpam])
  @@index([deletedAt])
  @@map("moderation_items")
}

model ModerationReport {
  id              String            @id @default(uuid()) @db.Uuid
  moderationItemId String           @map("moderation_item_id") @db.Uuid
  reporterId      String            @map("reporter_id") @db.Uuid
  reason          String            @db.VarChar(100)
  description     String?           @db.Text
  status          ModerationStatus  @default(pending)
  resolutionNote  String?           @map("resolution_note") @db.Text
  resolvedById    String?           @map("resolved_by_id") @db.Uuid
  resolvedAt      DateTime?         @map("resolved_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  moderationItem ModerationItem @relation(fields: [moderationItemId], references: [id], onDelete: Cascade)
  reporter       User            @relation("ModerationReportsFiled", fields: [reporterId], references: [id])
  resolvedBy     User?           @relation("ModerationReportsResolved", fields: [resolvedById], references: [id])

  @@index([moderationItemId, status])
  @@index([reporterId])
  @@index([status, createdAt(sort: Desc)])
  @@map("moderation_reports")
}

// ---------------------------------------------------------------------------
// Dispute Center
// ---------------------------------------------------------------------------

model Dispute {
  id               String          @id @default(uuid()) @db.Uuid
  ticketNumber     String          @unique @map("ticket_number") @db.VarChar(20)
  type             DisputeType
  priority         DisputePriority @default(medium)
  status           DisputeStatus   @default(open)
  
  // Parties involved
  reporterId       String          @map("reporter_id") @db.Uuid
  reportedUserId   String?         @map("reported_user_id") @db.Uuid
  listingId        String?         @map("listing_id") @db.Uuid
  conversationId   String?         @map("conversation_id") @db.Uuid
  
  // Dispute details
  title            String          @db.VarChar(200)
  description      String          @db.Text
  evidenceUrls     String[]        @default([]) @map("evidence_urls")
  chatEvidenceIds  String[]        @default([]) @map("chat_evidence_ids")
  
  // Resolution
  resolutionNote   String?         @map("resolution_note") @db.Text
  resolutionAction String?         @map("resolution_action") @db.VarChar(100)
  resolvedById     String?         @map("resolved_by_id") @db.Uuid
  resolvedAt       DateTime?       @map("resolved_at")
  closedAt         DateTime?       @map("closed_at")
  
  // Escalation
  escalatedAt      DateTime?       @map("escalated_at")
  escalatedById    String?         @map("escalated_by_id") @db.Uuid
  
  // Timestamps
  lastActivityAt   DateTime?       @map("last_activity_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  reporter       User          @relation("DisputeReporter", fields: [reporterId], references: [id])
  reportedUser   User?         @relation("DisputeReportedUser", fields: [reportedUserId], references: [id])
  listing        Listing?      @relation(fields: [listingId], references: [id])
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  resolvedBy     User?         @relation("DisputeResolver", fields: [resolvedById], references: [id])
  escalatedBy    User?         @relation("DisputeEscalator", fields: [escalatedById], references: [id])
  comments       DisputeComment[]

  @@index([status, priority, createdAt(sort: Desc)])
  @@index([reporterId])
  @@index([reportedUserId])
  @@index([type, status])
  @@index([ticketNumber])
  @@map("disputes")
}

model DisputeComment {
  id         String   @id @default(uuid()) @db.Uuid
  disputeId  String   @map("dispute_id") @db.Uuid
  authorId   String   @map("author_id") @db.Uuid
  content    String   @db.Text
  isInternal Boolean  @default(false) @map("is_internal")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id])

  @@index([disputeId, createdAt(sort: Desc)])
  @@index([authorId])
  @@map("dispute_comments")
}

// ---------------------------------------------------------------------------
// Homepage Content Management
// ---------------------------------------------------------------------------

model HomepageContent {
  id                String        @id @default(uuid()) @db.Uuid
  type              ContentType
  title             String        @db.VarChar(200)
  subtitle          String?       @db.VarChar(300)
  description       String?       @db.Text
  imageUrl          String?       @map("image_url") @db.VarChar(500)
  cloudinaryPublicId String?       @map("cloudinary_public_id") @db.VarChar(255)
  linkUrl           String?       @map("link_url") @db.VarChar(500)
  linkLabel         String?       @map("link_label") @db.VarChar(100)
  buttonText        String?       @map("button_text") @db.VarChar(100)
  backgroundColor   String?       @map("background_color") @db.VarChar(7)
  textColor         String?       @map("text_color") @db.VarChar(7)
  status            ContentStatus @default(draft)
  sortOrder         Int           @default(0) @map("sort_order")
  publishAt         DateTime?     @map("publish_at")
  unpublishAt       DateTime?     @map("unpublish_at")
  featuredListingId String?       @map("featured_listing_id") @db.Uuid
  featuredCategoryId String?      @map("featured_category_id") @db.Uuid
  createdById       String       @map("created_by_id") @db.Uuid
  updatedById       String?      @map("updated_by_id") @db.Uuid
  deletedAt         DateTime?    @map("deleted_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  featuredListing  Listing?      @relation("HomepageFeaturedListing", fields: [featuredListingId], references: [id])
  featuredCategory Category?     @relation("HomepageFeaturedCategory", fields: [featuredCategoryId], references: [id])
  createdBy        User          @relation("HomepageContentCreated", fields: [createdById], references: [id])
  updatedBy        User?         @relation("HomepageContentUpdated", fields: [updatedById], references: [id])

  @@index([type, status, sortOrder])
  @@index([status, publishAt])
  @@index([deletedAt])
  @@map("homepage_content")
}

// ---------------------------------------------------------------------------
// Vendor KYC Profile
// ---------------------------------------------------------------------------

model VendorKycProfile {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @unique @map("user_id") @db.Uuid
  businessName        String    @map("business_name") @db.VarChar(200)
  businessNameAm      String?   @map("business_name_am") @db.VarChar(200)
  tinNumber           String    @unique @map("tin_number") @db.VarChar(15)
  licenseUrl          String    @map("license_url") @db.VarChar(500)
  licenseCloudinaryId String?   @map("license_cloudinary_id") @db.VarChar(255)
  status              KycStatus @default(PENDING)
