// ---------------------------------------------------------------------------
// Rental Orders
// ---------------------------------------------------------------------------

model RentalOrder {
  id                    String        @id @default(uuid()) @db.Uuid
  orderNumber           String        @unique @map("order_number") @db.VarChar(20)
  listingId            String        @map("listing_id") @db.Uuid
  renterId             String        @map("renter_id") @db.Uuid
  sellerId             String        @map("seller_id") @db.Uuid
  
  // Rental Schedule
  startDate             DateTime      @map("start_date")
  endDate               DateTime      @map("end_date")
  actualReturnDate      DateTime?     @map("actual_return_date")
  
  // Financials
  dailyRate             Float         @map("daily_rate")
  totalAmount           Float         @map("total_amount")
  securityDeposit       Float         @map("security_deposit")
  depositRefunded       Boolean       @default(false) @map("deposit_refunded")
  depositRefundAmount   Float?        @map("deposit_refund_amount")
  depositRefundReason   String?       @map("deposit_refund_reason") @db.Text
  
  // Status
  status                RentalStatus  @default(REQUESTED)
  
  // Condition Logs
  preHandoverCondition  String?       @map("pre_handover_condition") @db.Text
  preHandoverPhotos     String[]      @default([]) @map("pre_handover_photos")
  postReturnCondition   String?       @map("post_return_condition") @db.Text
  postReturnPhotos      String[]      @default([]) @map("post_return_photos")
  damageNotes           String?       @map("damage_notes") @db.Text
  damageCost            Float?        @map("damage_cost")
  
  // Handover
  handoverLocation      String?       @map("handover_location") @db.VarChar(200)
  handoverAt            DateTime?     @map("handover_at")
  returnedAt            DateTime?     @map("returned_at")
  
  // Timestamps
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")
  
  listing               Listing       @relation(fields: [listingId], references: [id])
  renter                User          @relation("RentalRenter", fields: [renterId], references: [id])
  seller                User          @relation("RentalSeller", fields: [sellerId], references: [id])
  extensions            RentalExtension[]
  
  @@index([status, startDate])
  @@index([renterId])
  @@index([sellerId])
  @@index([listingId])
  @@index([orderNumber])
  @@map("rental_orders")
}

model RentalExtension {
  id              String    @id @default(uuid()) @db.Uuid
  rentalOrderId   String    @map("rental_order_id") @db.Uuid
  requestedBy     String    @map("requested_by") @db.Uuid
  additionalDays  Int       @map("additional_days")
  newEndDate      DateTime  @map("new_end_date")
  additionalCost  Float     @map("additional_cost")
  status          RentalStatus @default(REQUESTED)
  approvedById    String?   @map("approved_by_id") @db.Uuid
  approvedAt      DateTime? @map("approved_at")
  rejectionReason String?   @map("rejection_reason") @db.Text
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  
  rentalOrder     RentalOrder @relation(fields: [rentalOrderId], references: [id], onDelete: Cascade)
  requestedByUser User       @relation("ExtensionRequester", fields: [requestedBy], references: [id])
  approvedByUser  User?      @relation("ExtensionApprover", fields: [approvedById], references: [id])
  
  @@index([rentalOrderId, status])
  @@map("rental_extensions")
}

// ---------------------------------------------------------------------------
// Regional Hubs
// ---------------------------------------------------------------------------

model RegionHub {
  id              String    @id @default(uuid()) @db.Uuid
  name            String    @db.VarChar(100)
  nameAm          String?   @map("name_am") @db.VarChar(100)
  description     String?   @db.Text
  descriptionAm   String?   @map("description_am") @db.Text
  type            String    @db.VarChar(50) // sub_city, regional_city, pickup_point
  city            String    @db.VarChar(100)
  cityAm          String?   @map("city_am") @db.VarChar(100)
  coordinates     String?   @db.VarChar(100) // lat,lng
