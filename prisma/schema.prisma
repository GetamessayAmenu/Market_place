generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id              String           @id @default(uuid()) @db.Uuid
  name            String           @unique @db.VarChar(50)
  slug            String           @unique @db.VarChar(50)
  description     String?          @db.VarChar(255)
  isSystem        Boolean          @default(true) @map("is_system")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  rolePermissions RolePermission[]
  users           User[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  resource        String           @db.VarChar(50)
  action          String           @db.VarChar(50)
  description     String?          @db.VarChar(255)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@index([resource])
  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id                        String                @id @default(uuid()) @db.Uuid
  email                     String                @unique @db.VarChar(255)
  passwordHash              String                @map("password_hash") @db.VarChar(255)
  displayName               String                @map("display_name") @db.VarChar(100)
  avatarUrl                 String?               @map("avatar_url") @db.VarChar(500)
  phone                     String?               @unique @db.VarChar(20)
  emailVerifiedAt           DateTime?             @map("email_verified_at")
  phoneVerifiedAt           DateTime?             @map("phone_verified_at")
  status                    UserStatus            @default(active)
  roleId                    String                @map("role_id") @db.Uuid
  lastLoginAt               DateTime?             @map("last_login_at")
  deletedAt                 DateTime?             @map("deleted_at")
  createdAt                 DateTime              @default(now()) @map("created_at")
  updatedAt                 DateTime              @updatedAt @map("updated_at")
  bio                       String?
  location                  String?               @db.VarChar(200)
  sellerType                SellerType?           @map("seller_type")
  coverImageUrl             String?               @map("cover_image_url") @db.VarChar(500)
  specialties               String[]              @default([])
  socialLinks               Json?                 @map("social_links")
  responseRate              Int?                  @map("response_rate")
  responseTimeHours         Int?                  @map("response_time_hours")
  totalSales                Int?                  @map("total_sales")
  isVerifiedDesigner        Boolean               @default(false) @map("is_verified_designer")
  verifiedDesignerAt        DateTime?             @map("verified_designer_at")
  verifiedDesignerById      String?               @map("verified_designer_by_id") @db.Uuid
  adminLogs                 AdminLog[]
  callbackRequests          CallbackRequest[]
  chatFlagLogsResolved      ChatFlagLog[]         @relation("ChatFlagResolvedBy")
  buyerConversations        Conversation[]        @relation("BuyerConversations")
  sellerConversations       Conversation[]        @relation("SellerConversations")
  customOrdersAsBuyer       CustomOrder[]         @relation("CustomOrderBuyer")
  customOrdersAsSeller      CustomOrder[]         @relation("CustomOrderSeller")
  custom_quotes             CustomQuote[]
  disputeComments           DisputeComment[]
  disputesEscalated         Dispute[]             @relation("DisputeEscalator")
  disputesAgainst           Dispute[]             @relation("DisputeReportedUser")
  disputesReported          Dispute[]             @relation("DisputeReporter")
  disputesResolved          Dispute[]             @relation("DisputeResolver")
  favorites                 Favorite[]
  followers                 Follow[]              @relation("Following")
  following                 Follow[]              @relation("Followed")
  heroBannersCreated        HeroBanner[]          @relation("HeroBannerCreated")
  heroBannersUpdated        HeroBanner[]          @relation("HeroBannerUpdated")
  homepageContentCreated    HomepageContent[]     @relation("HomepageContentCreated")
  homepageContentUpdated    HomepageContent[]     @relation("HomepageContentUpdated")
  listings                  Listing[]
  sentMessages              Message[]
  moderationItemsModerated  ModerationItem[]      @relation("ModerationItemsModerated")
  moderationReportsFiled    ModerationReport[]    @relation("ModerationReportsFiled")
  moderationReportsResolved ModerationReport[]    @relation("ModerationReportsResolved")
  notifications             Notification[]
  buyerOrders               Order[]               @relation("BuyerOrders")
  sellerOrders              Order[]               @relation("SellerOrders")
  blackoutDatesCreated      RentalBlackoutDate[]  @relation("BlackoutDateCreatedBy")
  conditionLogsLogged       RentalConditionLog[]  @relation("ConditionLogLoggedBy")
  rentalExtensionsApproved  RentalExtension[]     @relation("ExtensionApprover")
  rentalExtensionsRequested RentalExtension[]     @relation("ExtensionRequester")
  rentalOrdersAsRenter      RentalOrder[]         @relation("RentalRenter")
  rentalOrdersAsSeller      RentalOrder[]         @relation("RentalSeller")
  reportsAgainst            Report[]              @relation("ReportedUser")
  reportsFiled              Report[]              @relation("ReportsFiled")
  reportsResolved           Report[]              @relation("ReportsResolved")
  reviewsModerated          Review[]              @relation("ReviewsModerated")
  reviewsWritten            Review[]              @relation("ReviewsWritten")
  reviewsReceived           Review[]              @relation("ReviewsReceived")
  role                      Role                  @relation(fields: [roleId], references: [id])
  verifiedDesignerBy        User?                 @relation("VerifiedDesigner", fields: [verifiedDesignerById], references: [id])
  verifiedDesigners         User[]                @relation("VerifiedDesigner")
  kycProfilesReviewed       VendorKycProfile[]    @relation("KycReviewer")
  vendorKycProfile          VendorKycProfile?
  verificationHistoryActor  VerificationHistory[] @relation("VerificationHistoryActor")
  verificationReviews       VerificationRequest[] @relation("VerificationReviewer")
  verificationRequests      VerificationRequest[]

  @@index([roleId])
  @@index([status])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([sellerType])
  @@map("users")
}

model Category {
  id                      String              @id @default(uuid()) @db.Uuid
  name                    String              @db.VarChar(100)
  slug                    String              @unique @db.VarChar(120)
  parentId                String?             @map("parent_id") @db.Uuid
  iconUrl                 String?             @map("icon_url") @db.VarChar(500)
  sortOrder               Int                 @default(0) @map("sort_order")
  isActive                Boolean             @default(true) @map("is_active")
  deletedAt               DateTime?           @map("deleted_at")
  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @updatedAt @map("updated_at")
  type                    CategoryType        @default(product)
  description             String?
  descriptionAm           String?             @map("description_am")
  nameAm                  String?             @map("name_am") @db.VarChar(100)
  slugAm                  String?             @map("slug_am") @db.VarChar(120)
  parent                  Category?           @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children                Category[]          @relation("CategoryHierarchy")
  categoryAttributes      CategoryAttribute[]
  homepageFeaturedContent HomepageContent[]   @relation("HomepageFeaturedCategory")
  listings                Listing[]

  @@index([parentId])
  @@index([isActive, deletedAt])
  @@index([sortOrder])
  @@index([type])
  @@map("categories")
}

model Attribute {
  id                 String              @id @default(uuid()) @db.Uuid
  name               String              @db.VarChar(100)
  type               AttributeType
  values             Json
  sortOrder          Int                 @default(0) @map("sort_order")
  isActive           Boolean             @default(true) @map("is_active")
  deletedAt          DateTime?           @map("deleted_at")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  description        String?
  descriptionAm      String?             @map("description_am")
  nameAm             String?             @map("name_am") @db.VarChar(100)
  categoryAttributes CategoryAttribute[]

  @@index([type])
  @@index([isActive, deletedAt])
  @@index([sortOrder])
  @@map("attributes")
}

model CategoryAttribute {
  id          String    @id @default(uuid()) @db.Uuid
  categoryId  String    @map("category_id") @db.Uuid
  attributeId String    @map("attribute_id") @db.Uuid
  required    Boolean   @default(false)
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, attributeId])
  @@index([categoryId])
  @@index([attributeId])
  @@map("category_attributes")
}

model Listing {
  id                      String                @id @default(uuid()) @db.Uuid
  sellerId                String                @map("seller_id") @db.Uuid
  categoryId              String                @map("category_id") @db.Uuid
  title                   String                @db.VarChar(200)
  slug                    String                @unique @db.VarChar(220)
  description             String
  price                   Decimal               @db.Decimal(12, 2)
  currency                String                @default("USD") @db.VarChar(3)
  condition               ListingCondition
  status                  ListingStatus         @default(draft)
  city                    String?               @db.VarChar(100)
  state                   String?               @db.VarChar(100)
  country                 String?               @db.VarChar(2)
  latitude                Decimal?              @db.Decimal(10, 7)
  longitude               Decimal?              @db.Decimal(10, 7)
  viewCount               Int                   @default(0) @map("view_count")
  publishedAt             DateTime?             @map("published_at")
  expiresAt               DateTime?             @map("expires_at")
  rejectedReason          String?               @map("rejected_reason") @db.VarChar(500)
  deletedAt               DateTime?             @map("deleted_at")
  createdAt               DateTime              @default(now()) @map("created_at")
  updatedAt               DateTime              @updatedAt @map("updated_at")
  isFeatured              Boolean               @default(false) @map("is_featured")
  contactOptions          Json?                 @map("contact_options")
  attributes              Json?
  availableForPurchase    Boolean               @default(true) @map("available_for_purchase")
  availableForRent        Boolean               @default(false) @map("available_for_rent")
  customOrderAvailable    Boolean               @default(false) @map("custom_order_available")
  rentalDeposit           Decimal?              @map("rental_deposit") @db.Decimal(12, 2)
  rentalPricePerDay       Decimal?              @map("rental_price_per_day") @db.Decimal(12, 2)
  rentalPricingTier       RentalPricingTier?    @map("rental_pricing_tier")
  rentalThreeDayRate      Decimal?              @map("rental_three_day_rate") @db.Decimal(12, 2)
  rentalWeeklyRate        Decimal?              @map("rental_weekly_rate") @db.Decimal(12, 2)
  cleaningPolicy          CleaningPolicy?       @map("cleaning_policy")
  fabricCareTags          String[]              @default([]) @map("fabric_care_tags")
  minRentalDurationDays   Int                   @default(1) @map("min_rental_duration_days")
  maxRentalDurationDays   Int?                  @map("max_rental_duration_days")
  supportsReadyMade       Boolean               @default(true) @map("supports_ready_made")
  supportsCustomDesign    Boolean               @default(false) @map("supports_custom_design")
  startingCustomPrice     Decimal?              @map("starting_custom_price") @db.Decimal(12, 2)
  estimatedProductionDays Int?                  @map("estimated_production_days")
  customizationOptions    Json?                 @map("customization_options")
  callbackRequests        CallbackRequest[]
  conversations           Conversation[]
  customOrders            CustomOrder[]
  disputes                Dispute[]
  favorites               Favorite[]
  homepageFeaturedContent HomepageContent[]     @relation("HomepageFeaturedListing")
  images                  ListingImage[]
  priceHistory            ListingPriceHistory[]
  category                Category              @relation(fields: [categoryId], references: [id])
  seller                  User                  @relation(fields: [sellerId], references: [id])
  orders                  Order[]
  rentalBlackoutDates     RentalBlackoutDate[]
  rentalOrders            RentalOrder[]
  reports                 Report[]
  reviews                 Review[]

  @@index([sellerId, status])
  @@index([categoryId, status])
  @@index([status, createdAt(sort: Desc)])
  @@index([status, publishedAt(sort: Desc)])
  @@index([city, country])
  @@index([price])
  @@index([deletedAt])
  @@index([createdAt(sort: Desc)])
  @@index([availableForPurchase, status])
  @@index([availableForRent, status])
  @@index([customOrderAvailable, status])
  @@map("listings")
}

model ListingImage {
  id                 String    @id @default(uuid()) @db.Uuid
  listingId          String    @map("listing_id") @db.Uuid
  url                String    @db.VarChar(500)
  cloudinaryPublicId String    @map("cloudinary_public_id") @db.VarChar(255)
  sortOrder          Int       @default(0) @map("sort_order")
  isPrimary          Boolean   @default(false) @map("is_primary")
  deletedAt          DateTime? @map("deleted_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  listing            Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, sortOrder])
  @@index([listingId, isPrimary])
  @@index([deletedAt])
  @@map("listing_images")
}

model Favorite {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  listingId String   @map("listing_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([listingId])
  @@map("favorites")
}

model Follow {
  id          String   @id @default(uuid()) @db.Uuid
  followerId  String   @map("follower_id") @db.Uuid
  followingId String   @map("following_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  follower    User     @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Followed", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("follows")
}

model Conversation {
  id            String        @id @default(uuid()) @db.Uuid
  listingId     String        @map("listing_id") @db.Uuid
  buyerId       String        @map("buyer_id") @db.Uuid
  sellerId      String        @map("seller_id") @db.Uuid
  lastMessageAt DateTime?     @map("last_message_at")
  deletedAt     DateTime?     @map("deleted_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  isFlagged     Boolean       @default(false) @map("is_flagged")
  riskScore     Int           @default(0) @map("risk_score")
  chatFlagLogs  ChatFlagLog[]
  buyer         User          @relation("BuyerConversations", fields: [buyerId], references: [id])
  listing       Listing       @relation(fields: [listingId], references: [id])
  seller        User          @relation("SellerConversations", fields: [sellerId], references: [id])
  customOrders  CustomOrder[]
  disputes      Dispute[]
  messages      Message[]
  orders        Order?
  reports       Report[]

  @@unique([listingId, buyerId, sellerId])
  @@index([buyerId, lastMessageAt(sort: Desc)])
  @@index([sellerId, lastMessageAt(sort: Desc)])
  @@index([isFlagged, riskScore(sort: Desc)])
  @@index([deletedAt])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  senderId       String       @map("sender_id") @db.Uuid
  content        String       @map("body")
  readAt         DateTime?    @map("read_at")
  deletedAt      DateTime?    @map("deleted_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  isFlagged      Boolean      @default(false) @map("is_flagged")
  metadata       Json?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id])
  reports        Report[]

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([senderId])
  @@index([isFlagged])
  @@index([readAt])
  @@index([deletedAt])
  @@map("messages")
}

model ChatFlagLog {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId   String         @map("conversation_id") @db.Uuid
  flaggedByUserId  String?        @map("flagged_by_user_id") @db.Uuid
  reason           ChatFlagReason @map("reason")
  keywordTriggered String?        @map("keyword_triggered")
  status           ChatFlagStatus @default(PENDING_REVIEW)
  action           String?        @map("action")
  actionReason     String?        @map("action_reason")
  resolvedById     String?        @map("resolved_by_id") @db.Uuid
  resolvedAt       DateTime?      @map("resolved_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  conversation     Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  resolvedBy       User?          @relation("ChatFlagResolvedBy", fields: [resolvedById], references: [id])

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([flaggedByUserId])
  @@index([resolvedById])
  @@map("chat_flag_logs")
}

model Report {
  id             String           @id @default(uuid()) @db.Uuid
  reporterId     String           @map("reporter_id") @db.Uuid
  targetType     ReportTargetType @map("target_type")
  listingId      String?          @map("listing_id") @db.Uuid
  reportedUserId String?          @map("reported_user_id") @db.Uuid
  messageId      String?          @map("message_id") @db.Uuid
  conversationId String?          @map("conversation_id") @db.Uuid
  reason         String           @db.VarChar(100)
  description    String?
  status         ReportStatus     @default(pending)
  resolvedById   String?          @map("resolved_by_id") @db.Uuid
  resolvedAt     DateTime?        @map("resolved_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  closedAt       DateTime?        @map("closed_at")
  evidence       String[]         @default([])
  resolutionNote String?          @map("resolution_note")
  conversation   Conversation?    @relation(fields: [conversationId], references: [id])
  listing        Listing?         @relation(fields: [listingId], references: [id])
  message        Message?         @relation(fields: [messageId], references: [id])
  reportedUser   User?            @relation("ReportedUser", fields: [reportedUserId], references: [id])
  reporter       User             @relation("ReportsFiled", fields: [reporterId], references: [id])
  resolvedBy     User?            @relation("ReportsResolved", fields: [resolvedById], references: [id])

  @@index([status, createdAt(sort: Desc)])
  @@index([targetType, status])
  @@index([reporterId])
  @@index([listingId])
  @@index([reportedUserId])
  @@map("reports")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String           @db.VarChar(200)
  body      String?
  data      Json?
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt(sort: Desc)])
  @@index([type])
  @@map("notifications")
}

model AdminLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  action     String   @db.VarChar(100)
  resource   String   @db.VarChar(50)
  resourceId String?  @map("resource_id") @db.Uuid
  metadata   Json?
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.VarChar(500)
  createdAt  DateTime @default(now()) @map("created_at")
  actor      User     @relation(fields: [actorId], references: [id])

  @@index([actorId, createdAt(sort: Desc)])
  @@index([resource, resourceId])
  @@index([action])
  @@index([createdAt(sort: Desc)])
  @@map("admin_logs")
}

model Order {
  id                       String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderNumber              String        @unique @map("order_number") @db.VarChar(20)
  type                     OrderType
  status                   OrderStatus   @default(INQUIRY_PENDING)
  buyerId                  String        @map("buyer_id") @db.Uuid
  sellerId                 String        @map("seller_id") @db.Uuid
  productId                String        @map("product_id") @db.Uuid
  conversationId           String?       @unique @map("conversation_id") @db.Uuid
  agreedPrice              Decimal       @map("agreed_price") @db.Decimal(10, 2)
  agreed_deposit           Decimal?      @db.Decimal(10, 2)
  offline_deposit_refunded Boolean?      @default(false)
  customMeasurements       Json?         @map("custom_measurements")
  fitting_date             DateTime?     @db.Timestamp(6)
  rentalStartDate          DateTime?     @map("rental_start_date") @db.Timestamp(6)
  rentalEndDate            DateTime?     @map("rental_end_date") @db.Timestamp(6)
  extension_days_requested Int?          @default(0)
  extension_approved       Boolean?
  pre_handover_photos      String[]      @default([])
  post_return_photos       String[]      @default([])
  dispute_notes            String?
  createdAt                DateTime?     @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt                DateTime?     @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  customQuotes             CustomQuote[]
  buyer                    User          @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  conversations            Conversation? @relation(fields: [conversationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product                  Listing       @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  seller                   User          @relation("SellerOrders", fields: [sellerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([orderNumber])
  @@index([buyerId, status], map: "orders_buyer_status_idx")
  @@index([sellerId, status], map: "orders_seller_status_idx")
  @@map("orders")
}

model CustomQuote {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId            String    @map("order_id") @db.Uuid
  offered_by_user_id String    @db.Uuid
  proposedPrice      Decimal   @map("proposed_price") @db.Decimal(10, 2)
  proposedDeposit    Decimal?  @map("proposed_deposit") @db.Decimal(10, 2)
  notes              String?
  isAccepted         Boolean?  @default(false) @map("is_accepted")
  createdAt          DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  users              User      @relation(fields: [offered_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  order              Order     @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([offered_by_user_id], map: "custom_quotes_offered_by_idx")
  @@index([orderId], map: "custom_quotes_order_idx")
  @@map("custom_quotes")
}

model CustomOrder {
  id                String            @id @default(uuid()) @db.Uuid
  listingId         String            @map("listing_id") @db.Uuid
  buyerId           String            @map("buyer_id") @db.Uuid
  sellerId          String            @map("seller_id") @db.Uuid
  status            CustomOrderStatus @default(submitted)
  measurements      Json?
  conversationId    String?           @map("conversation_id") @db.Uuid
  cancelledReason   String?           @map("cancelled_reason") @db.VarChar(500)
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  agreedPrice       Decimal?          @map("agreed_price") @db.Decimal(12, 2)
  buyerNotes        String?           @map("buyer_notes")
  embroideryNotes   String?           @map("embroidery_notes")
  inspirationImages String[]          @map("inspiration_images")
  selectedColor     String?           @map("selected_color") @db.VarChar(100)
  selectedFabric    String?           @map("selected_fabric") @db.VarChar(100)
  selectedSize      String?           @map("selected_size") @db.VarChar(50)
  buyer             User              @relation("CustomOrderBuyer", fields: [buyerId], references: [id])
